# Copy to .env and adjust. Docker Compose sets these on its own.
DATABASE_URL=postgresql+asyncpg://subsea:subsea@localhost:5432/subsea
DEBUG=false
MAX_READING_AGE_DAYS=365
MAX_BATCH_SIZE=5000

# Used by the test suite. Leave unset to run on in-memory SQLite.
# TEST_DATABASE_URL=postgresql+asyncpg://subsea:subsea@localhost:5432/subsea_test
